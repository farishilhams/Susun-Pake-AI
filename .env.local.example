# ============================================================
# .env.local.example — Template Variabel Lingkungan Susunpakeai
# 
# ⚠️  FILE INI ADALAH TEMPLATE AMAN DENGAN NILAI DUMMY/PLACEHOLDER
# ⚠️  JANGAN PERNAH MENGISI FILE INI DENGAN KUNCI/PRODUKSI ASLI!
#
# INSTRUKSI PENGGUNAAN:
# 1. Salin file ini menjadi .env.local:
#    cp .env.local.example .env.local
# 2. Isi nilai aktual di .env.local (file tersebut di-ignore oleh Git)
# ============================================================

# --- DATABASE (MONGODB) ---
# Format URI: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/susunpakeai?retryWrites=true&w=majority

# --- NEXTAUTH (AUTENTIKASI SESI) ---
# Secret 32 karakter untuk enkripsi token JWT sesi (generate: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_32_characters_min_here
AUTH_SECRET=your_auth_secret_32_characters_min_here
# URL dasar aplikasi
NEXTAUTH_URL=http://localhost:3000

# --- GOOGLE OAUTH 2.0 ---
# Kredensial OAuth dari Google Cloud Console > APIs & Services > Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- AI PROVIDERS (GOOGLE AI STUDIO - ZERO BILLING) ---
# ⚠️  ATURAN KEAMANAN WAJIB (ARCHITECTURE.md § 2 & SECURITY.md):
#     API key Gemini HANYA dari Google AI Studio (https://aistudio.google.com/apikey)
#     BUKAN dari Google Cloud Console / Vertex AI biasa.
#     TIDAK ADA kartu kredit/billing account yang dihubungkan ke project ini.
GOOGLE_AI_STUDIO_API_KEY=your_gemini_api_key_from_google_ai_studio_here

# Groq API Key — penyedia fallback pertama (daftar gratis di https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key — penyedia fallback kedua (daftar gratis di https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- KONFIGURASI APLIKASI ---
# URL publik aplikasi (server-side & client-side referer)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Batas pembuatan dokumen harian per pengguna
DAILY_GENERATE_LIMIT=5

# --- LAYANAN EMAIL (RESET PASSWORD) ---
# API key dari https://resend.com (tier gratis 3.000 email/bulan)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="Susun Pake AI <onboarding@resend.dev>"

# --- GITHUB OAUTH (PUSH TO GITHUB) ---
# Kredensial GitHub OAuth App (Settings > Developer settings > OAuth Apps)
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# --- ENKRIPSI TOKEN GITHUB (AES-256-GCM) ---
# Kunci simetris 32-byte hex untuk enkripsi token GitHub user
ENCRYPTION_KEY=your_32_byte_encryption_key_here
